{
  "tasks": [
    

    {
      "label": "bootcamp cmake configure",
      "type": "shell",
      "command": 
      "cmake -S ${workspaceFolder}/15445-bootcamp -B ${workspaceFolder}/15445-bootcamp/build -DCMAKE_BUILD_TYPE=Debug -DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/15445-bootcamp/clang-toolchain.cmake",
      "problemMatcher": []
    },

    {
      "label": "bootcamp cmake build",
      "type": "shell",
      // "command": "cmake --build ${workspaceFolder}/15445-bootcamp/build",
      "command": "cmake --build ${workspaceFolder}/15445-bootcamp/build --target iterator",
      "dependsOn":"bootcamp cmake configure",
      "group": "build",
      "problemMatcher": []
    },
    {
      "type": "cppbuild",
      "label": "C/C++: gcc build active file",
      "command": "/usr/bin/gcc",
      "args": [
        "-fdiagnostics-color=always",
        "-g",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}",
        "-lpthread"
        // "${workspaceFolder}/xv6-riscv",
        // "-I${workspaceFolder}/xv6-riscv",
        // "-I${workspaceFolder}/code_examples/include"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      // "detail": "Task generated by Debugger."
      "detail": "compiler: /usr/bin/gcc"
    },
    {
      "label": "clang++ build active file",
      "type": "cppbuild",
      "command": "/usr/bin/clang++",
      "args": [
        "-fdiagnostics-color=always",
        "-g", // debug symbols
        "${file}",
        // "-std=c++17",
        // "-Wall",
        // "-Wextra",
        // "-Wpedantic",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}",
        "-lpthread"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
    }
    
  ],
  "version": "2.0.0"
}